# Copia este archivo a `.env` y completa los valores desde https://www.sanity.io/manage
# Ejecuta: cp .env.example .env

# Project ID de Sanity (ej: abc123d4). Se encuentra en Manage > tu proyecto > Settings > API.
SANITY_STUDIO_PROJECT_ID=TU_PROJECT_ID

# Nombre del dataset (por defecto: production)
SANITY_STUDIO_DATASET=production

# Token de API para importar/leer datos (Manage > tu proyecto > API > Tokens)
# Scope recomendado para importación: editor . Para el frontend: viewer (solo lectura)
SANITY_API_TOKEN=TU_TOKEN_DE_API